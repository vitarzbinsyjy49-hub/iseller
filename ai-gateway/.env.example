# AI Gateway (Mac mini). Скопируй в .env рядом и заполни.
# Ollama слушает только localhost — НЕ публикуй 11434 наружу.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:14b
# Быстрая модель для простых интентов (опционально; пусто = не используется)
OLLAMA_FAST_MODEL=

# Общий секрет с VPS (backend .env: AI_GATEWAY_API_KEY). Сгенерируй: openssl rand -hex 32
AI_GATEWAY_API_KEY=CHANGE_ME

AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=700
AI_TEMPERATURE=0.4
AI_MAX_CONCURRENCY=2
AI_RATE_LIMIT_PER_MINUTE=30
AI_PAYLOAD_LIMIT_BYTES=65536

# Порт самого гейтвея (доступен VPS по приватной сети, например Tailscale)
GATEWAY_PORT=8100
