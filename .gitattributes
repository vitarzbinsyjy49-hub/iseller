# Файлы, которые исполняются на Linux-сервере, ДОЛЖНЫ иметь LF-переносы,
# иначе bash/Docker ломаются на Windows-CRLF (\r).
*.sh            text eol=lf
Dockerfile*     text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Caddyfile       text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
.env*           text eol=lf
# systemd-юниты: возврат каретки в конце ExecStart= уезжает в саму команду,
# и юнит падает с невнятным "No such file or directory".
*.service       text eol=lf
*.timer         text eol=lf
