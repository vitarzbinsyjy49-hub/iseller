# Файлы, которые исполняются на Linux-сервере, ДОЛЖНЫ иметь LF-переносы,
# иначе bash/Docker ломаются на Windows-CRLF (\r).
*.sh            text eol=lf
Dockerfile*     text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Caddyfile       text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
.env*           text eol=lf
