# ============================================================
# TechShop Demo MVP — переменные окружения основного backend
# Скопируйте в .env и при необходимости замените значения.
# Демо запускается БЕЗ реальных ключей (AI_PROVIDER=fallback).
# ============================================================

# ---- База данных (совпадает с POSTGRES_* в compose) ----
POSTGRES_USER=techshop
POSTGRES_PASSWORD=techshop
POSTGRES_DB=techshop
DATABASE_URL=postgresql+psycopg://techshop:techshop@db:5432/techshop

# ---- Аутентификация ----
# Демо: DEV_MODE=true разрешает вход без Telegram (/auth/dev). На проде — false.
DEV_MODE=true
JWT_SECRET=change-me-please-long-random-string
ADMIN_EMAIL=admin@techshop.local
ADMIN_PASSWORD=admin12345

# ---- Telegram (для запуска в реальном Telegram; для локального демо не обязательно) ----
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
MINI_APP_URL=
WEBAPP_URL=

# ---- CORS ----
# DEV_MODE=true: разрешены localhost + широкий https. На проде задать реальные домены:
ALLOWED_ORIGINS=

# ---- Режим AI ----
# fallback | mock — не требует Ollama/ключей, отвечает по каталогу (ДЕМО ПО УМОЛЧАНИЮ).
# ai            — использовать AI Engine (нужны Ollama или облачный провайдер).
AI_PROVIDER=fallback

# ---- AI Engine (нужно только при AI_PROVIDER=ai) ----
AI_ENGINE_URL=http://ai-engine:8090
AI_ENGINE_API_KEY=change-me
AI_ENGINE_TIMEOUT_SECONDS=20

# ---- Экспорт каталога для AI Engine ----
# Совпадает с CATALOG_API_KEY в ai-engine/.env
CATALOG_EXPORT_API_KEY=change-me-catalog-key

# ---- Rate limit на /api/ai/chat ----
AI_CHAT_RATE_LIMIT_PER_MINUTE=10
# (опционально) Redis для распределённого лимита; пусто => in-memory
RATE_LIMIT_REDIS_URL=

# ---- Meilisearch master key (для AI Engine) ----
MEILISEARCH_KEY=masterKey
