# ============================================================
# AI Seller — PRODUCTION .env для VPS.
# На сервере скопировать в .env и заполнить значения:
#   cp .env.prod.example .env  &&  nano .env
# ============================================================

# ---- Домены (два бесплатных поддомена DuckDNS) ----
# Указывают на IP этого сервера. HTTPS выдаст Caddy автоматически.
DOMAIN=techshop-demo.duckdns.org
ADMIN_DOMAIN=techshop-admin.duckdns.org

# ---- База данных ----
POSTGRES_USER=techshop
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=techshop
DATABASE_URL=postgresql+psycopg://techshop:CHANGE_ME_strong_db_password@db:5432/techshop

# ---- Аутентификация ----
# PROD: DEV_MODE=false — вход только через настоящий Telegram initData.
# (Если нужно временно показывать демо и в обычном браузере — поставь true.)
DEV_MODE=false
JWT_SECRET=CHANGE_ME_long_random_string_min_32_chars
ADMIN_EMAIL=admin@techshop.local
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---- Бренд и публичные контакты ----
APP_NAME=AI Seller
# Укажите реальный аккаунт человека/поддержки. Ссылка на обычного бота без
# маршрутизации сообщений менеджеру не заменяет контакт менеджера.
MANAGER_RETAIL_URL=https://t.me/CHANGE_ME_RETAIL_MANAGER
MANAGER_WHOLESALE_URL=
MANAGER_B2B_URL=
MANAGER_TRADEIN_URL=
TELEGRAM_CHANNEL_URL=https://t.me/CHANGE_ME_CHANNEL

# ---- Telegram ----
# Токен и username бота из @BotFather.
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
MINI_APP_URL=https://techshop-demo.duckdns.org
WEBAPP_URL=https://techshop-demo.duckdns.org

# ---- CORS ----
# В проде обязателен непустой список (иначе backend не стартует).
# Same-origin, но перечисляем оба домена + Telegram на всякий случай.
ALLOWED_ORIGINS=https://techshop-demo.duckdns.org,https://techshop-admin.duckdns.org,https://web.telegram.org

# ---- AI ----
AI_PROVIDER=fallback
AI_CHAT_RATE_LIMIT_PER_MINUTE=10
