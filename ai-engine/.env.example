# AI Engine env for docker-compose.demo.yml
# Used only when running with: docker compose -f docker-compose.demo.yml --profile ai up -d --build

AI_ENGINE_ENV=production
AI_ENGINE_API_KEY=change-me

# SQLAlchemy async engine requires postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://ai:ai@ai-db:5432/ai_engine

REDIS_URL=redis://redis:6379/0

SEARCH_BACKEND=postgres
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_KEY=masterKey

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_URL=http://ollama:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

MAX_PRODUCTS_TO_LLM=12
SEMANTIC_CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Must match backend CATALOG_EXPORT_API_KEY
CATALOG_API_URL=http://backend:8000/api/catalog/export
CATALOG_API_KEY=change-me-catalog-key
CRM_API_URL=
ANALYTICS_WEBHOOK_URL=
