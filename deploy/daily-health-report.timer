[Unit]
Description=Сводка о состоянии сервера раз в сутки

[Timer]
# 10:00 по Москве: сервер живёт в Europe/Moscow, отдельная TZ не нужна.
OnCalendar=*-*-* 10:00:00
# Сервер был выключен в момент запуска — отчёт уходит сразу после старта,
# а не пропадает до следующих суток.
Persistent=true
# Разброс в пару минут, чтобы отчёт не бился за CPU с ночными задачами.
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
