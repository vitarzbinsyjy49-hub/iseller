# Caddy автоматически получает и продлевает HTTPS-сертификаты Let's Encrypt.
# Домены берутся из переменных окружения (см. docker-compose.prod.yml).

# Общие security-заголовки. Вынесены в сниппет, чтобы оба домена (Mini App и
# админка) не разъезжались: заголовок, добавленный только в одном месте, —
# ложное чувство защиты. Полноценного CSP намеренно НЕТ: Mini App грузит
# telegram-web-app.js с t.me и инлайнит стили Vite, а неверный CSP молча ломает
# витрину сильнее, чем отсутствие заголовка.
#
# Политика встраивания во фрейм здесь СОЗНАТЕЛЬНО не общая — у двух доменов она
# обязана быть разной и задаётся в каждом блоке отдельно. Это единственное
# исключение из правила выше, причина — в комментарии у {$DOMAIN}.
(security_headers) {
    header {
        # Браузер не «угадывает» MIME вопреки Content-Type (защита от подмены
        # типа загруженного контента).
        X-Content-Type-Options "nosniff"
        # HSTS: год, включая поддомены. Домен уже только по HTTPS (редирект 308),
        # заголовок закрывает окно первого запроса по http.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Реферер наружу не утекает с полным путём.
        Referrer-Policy "strict-origin-when-cross-origin"
        # Явно отзываем мощные API, которые магазину не нужны.
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        # Не раскрываем, что под капотом.
        -Server
    }
}

# Mini App (frontend) — основной домен:
{$DOMAIN} {
    encode gzip zstd
    import security_headers

    # Витрину ОБЯЗАНО быть можно встроить во фрейм Telegram Web. Здесь стоял
    # X-Frame-Options "DENY" с комментарием «Mini App живёт в webview, а не во
    # фрейме» — это верно только для нативных клиентов. Telegram Web на
    # десктопе (web.telegram.org в обычном браузере) открывает Mini App именно
    # в <iframe>, и DENY заставлял браузер молча отказаться его рисовать:
    # кнопка «Каталог» в канале давала белый экран навсегда — при живом
    # сервере, здоровом /api/health и без единой записи в логах.
    #
    # X-Frame-Options не умеет список источников (ALLOW-FROM мёртв, Chrome его
    # игнорирует), поэтому здесь frame-ancestors: это CSP ровно с одной
    # директивой, ничего кроме встраивания она не ограничивает и витрину
    # сломать не может. От кликджекинга защищает не хуже DENY — чужой сайт
    # по-прежнему в запрете, разрешён только Telegram.
    header Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org"

    # API идёт в backend...
    handle /api/* {
        reverse_proxy backend:8000
    }

    # ...всё остальное — статика Mini App
    handle {
        reverse_proxy frontend:80
    }
}

# Админка — отдельный поддомен (второй бесплатный DuckDNS-субдомен):
{$ADMIN_DOMAIN} {
    encode gzip zstd
    import security_headers

    # Админку во фрейм не встраивает никто и никогда: в Telegram она не живёт,
    # послабление витрины ей не нужно и опасно.
    header X-Frame-Options "DENY"

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy admin:80
    }
}
