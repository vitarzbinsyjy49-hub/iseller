[Unit]
Description=Проверка состояния AI Seller раз в две минуты

[Timer]
# Первый запуск через минуту после старта: сразу после перезагрузки контейнеры
# ещё поднимаются, и проверять их в эту секунду бессмысленно.
OnBootSec=1min
OnUnitActiveSec=2min
# Догонять пропущенные тики не нужно: состояние сервера — это «сейчас», а не
# история. Persistent здесь дал бы залп тревог после каждой перезагрузки.
AccuracySec=15s

[Install]
WantedBy=timers.target
